direction: down

product: 产品域 {
  direction: down
  strategy: "策略榜单表"
  nav: "策略净值曲线表"
  position: "策略持仓表"
  follow: "用户关注表" {
    style.fill: "#172554"
    style.stroke: "#60a5fa"
  }
  strategy -> nav: 一对多
  strategy -> position: 一对多
}

mirror: "行情镜像辅助表" {
  direction: down
  row1: "" {
    direction: right
    limit: "涨跌停价表"
    st: "ST 区间表"
    suspend: "停牌表"
  }
  row2: "" {
    direction: right
    share: "流通股本表"
    calendar: "交易日历表"
    industry: "申万行业表"
  }
}

product -> mirror: "" {style.opacity: 0}
mirror -> note: "" {style.opacity: 0}

note: "策略榜单净值当前可为演示数据\n选股回测绩效由组合引擎真实计算" {
  shape: text
  style.font-size: 16
}
