direction: down

rules: "" {
  direction: right
  buy: "买入信号" {
    style.fill: "#172554"
    style.stroke: "#60a5fa"
  }
  sell: "卖出信号" {
    style.fill: "#3b1824"
    style.stroke: "#fb7185"
  }
  catalog: "信号注册表" {
    style.fill: "#3b2a14"
    style.stroke: "#fb923c"
  }
  buy -> catalog
  sell -> catalog
}

sinks: "" {
  direction: right
  meta: "枚举接口" {
    style.fill: "#12352c"
    style.stroke: "#34d399"
  }
  engine: "日频循环" {
    style.fill: "#1e293b"
    style.stroke: "#94a3b8"
  }
}

rules.catalog -> sinks.meta
rules.catalog -> sinks.engine

note: "扩展：新增一条规则并登记后重启服务" {
  shape: text
  style.font-size: 14
}
